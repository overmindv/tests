# Копия: cp .env.example .env  — и заполните реальными значениями.

# Базовый URL api-gateway (главная точка входа для всех e2e-сценариев).
# При подъёме стека через infra docker-compose шлюз публикуется на 8081.
BASE_URL=http://localhost:8081

# GraphQL-эндпоинт api-gateway.
GRAPHQL_PATH=/graphql

# Таймауты (секунды).
API_READ_TIMEOUT=30
API_CONNECT_TIMEOUT=10

# Bootstrap-суперпользователь (совпадает с infra/.env): фикстура `admin` логинится под ним.
BOOTSTRAP_SUPERUSER_EMAIL=admin@overmindv.com
BOOTSTRAP_SUPERUSER_USERNAME=superadmin
BOOTSTRAP_SUPERUSER_PASSWORD=<пароль из infra/.env>

# Поведение.
# true — генерировать уникальные данные через mimesis (рекомендуется для изоляции тестов).
# false — использовать фиксированные значения (для детерминированного локального запуска).
GENERATE_UNIQUE_DATA=true

# Параллельность pytest (0 — отключить xdist).
PYTEST_NUM_WORKERS=0

# Rerun упавших тестов (0 — отключить).
PYTEST_RERUNS=2

# Повторная попытка ожидания ответа сервиса (для фикстуры health-check).
SERVICE_READY_ATTEMPTS=30
SERVICE_READY_SLEEP=2